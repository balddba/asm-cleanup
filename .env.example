# Copy to .env and set real values before `docker compose up`.
# Prefer: ./scripts/setup_env.sh  (generates password, JWT secret, keyring key)
# Do not commit real secrets.

ASM_CLEANUP_PASSWORD=change-me
ASM_CLEANUP_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
ASM_CLEANUP_KEYRING_KEY=change-me-to-a-long-random-string-at-least-32-bytes
ASM_CLEANUP_PORT=8000
ASM_CLEANUP_DEMO_PORT=8001

# Optional: cryptfile path (default: next to the SQLite database)
# ASM_CLEANUP_KEYRING_FILE=/data/ssh_keys.cryptfile.cfg

# Optional local runtime database URL (Docker Compose sets its own /data URL)
# DATABASE_URL=sqlite:///asm_cleanup.db

# Timezone name for generated files and database records (e.g. America/Detroit or UTC)
ASM_CLEANUP_TIMEZONE=UTC
